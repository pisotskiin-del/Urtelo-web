# Скопируйте этот файл в .env рядом с manage.py и впишите значения (переменные окружения важнее).
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Каталог с таблицами старой программы и кодировка (пусто = по заголовку DBF)
DBF_SOURCE_DIR=D:\teplo_dog
DBF_ENCODING=

# PostgreSQL вместо SQLite
# DB_ENGINE=postgresql
# DB_NAME=teplo
# DB_USER=teplo
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Папка для выгрузки в 1С задаётся в «Справочники» → «Настройки программы»;
# эта переменная — только если там пусто
# TEPLO_1C_DIR=\\SERVER-FF\Abon_teplo1C

# Папка PDF документов абонентам (по участкам и месяцам), например
# TEPLO_DOC_DIR=D:\Teplo_dog\Akt_potreb_web

# Пароль почтового ящика для рассылки (иначе берётся из «Настройки рассылки писем»)
# TEPLO_SMTP_PASSWORD=
# Первый номер документа в реестре писем
# TEPLO_PISMO_NOMER=1

# КРЭДО (РРИЦ): адрес сервиса и отпечатки сертификатов клиента по участкам
# (сертификаты — в хранилище «Личные» пользователя Windows, под которым работает программа)
# TEPLO_KREDO_ENDPOINT=http://www.rric.org:7742/RRIC_EP_SERVICE/WcfService
# TEPLO_KREDO_THUMB_RYB=eb89da47d567beee800118756e9b31568bf95072
# TEPLO_KREDO_THUMB_DUB=e968ac9950fc5bd24953ec529980a8eac2e57e10
# TEPLO_KREDO_THUMB_KAM=aedfd090498ab56b99b683782bba47fcd98d473c
